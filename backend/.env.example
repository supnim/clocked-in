# Copy to .env for local docker compose. NEVER commit a real .env.

# Development mode. DEBUG=true allows a built-in dev JWT secret when JWT_SECRET
# is unset. Production MUST use DEBUG=false.
DEBUG=true

# Database
DATABASE_URL=postgresql://clockedin:clockedin_dev@localhost:55432/clockedin
POSTGRES_USER=clockedin
POSTGRES_PASSWORD=clockedin_dev
POSTGRES_DB=clockedin

# Redis (prod: include password, e.g. rediss://default:PASSWORD@host:6379)
REDIS_URL=redis://localhost:6379/0

# JWT — REQUIRED in production, at least 32 bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Access token lifetime in hours. Default 720 (30 days).
JWT_EXPIRATION_HOURS=720

# Reverse proxy. Set TRUST_PROXY=true ONLY when the app is reachable solely
# through your proxy (Fly.io, Caddy, nginx). The client IP for rate limiting
# is then taken PROXY_HOPS entries from the right of X-Forwarded-For.
TRUST_PROXY=false
PROXY_HOPS=1
# Passed to uvicorn --forwarded-allow-ips by scripts/entrypoint.sh
FORWARDED_ALLOW_IPS=127.0.0.1

# Run scripts/migrate.py before starting uvicorn (container entrypoint).
MIGRATE_ON_START=true

# Rate limits (fixed window, Redis). Override any limit as <count>/<seconds>:
# RATE_LIMIT_AUTH_DEVICE=10/3600     # POST /auth/device, per IP
# RATE_LIMIT_SEARCH=60/60            # GET /api/users/search, per user
# RATE_LIMIT_FRIEND_REQUEST=30/3600  # POST /api/friends/request/*, per user
# RATE_LIMIT_REPORT=20/86400         # POST /api/users/*/report, per user
# RATE_LIMIT_ENABLED=true

# Google OAuth (hidden in the v1 client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Apple Sign-In
APPLE_BUNDLE_ID=gold.studio.clocked-in
